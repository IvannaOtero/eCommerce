@model eCommerce.Models.ProductListViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="fs-1 fw-bold">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    <p class="mt-3">Showing @Model.ProductsPerPage products per page. Page @Model.CurrentPage of @Model.TotalPages</p>

</div> 

<div class="alert alert-info" role="alert">
    This website is under construction

</div>

<div class="row">
    @foreach (var product in Model.Products)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@product.Title</h5>
                    <p class="card-text">@product.Price.ToString("C")</p>
                </div>
            </div>
        </div>
    }
</div>

<nav aria-label="Product pagination">
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-controller="Home" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>
