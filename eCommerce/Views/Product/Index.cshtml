@model IEnumerable<Product>
@{
	ViewData["Title"] = "Product Listings"; 
}

<h2>Product Listing</h2>

<form method="get" asp-action="Index" class="row g-2 mb-3">
	<div class="col-md-4">
		<input name="title" class="form-control" placeholder="Search title" value="@(Context.Request.Query["title"])" />
	</div>
	<div class="col-md-2">
		<input name="minPrice" type="number" step="0.01" min="0" class="form-control" placeholder="Min price" value="@(Context.Request.Query["minPrice"])" />
	</div>
	<div class="col-md-2">
		<input name="maxPrice" type="number" step="0.01" min="0" class="form-control" placeholder="Max price" value="@(Context.Request.Query["maxPrice"])" />
	</div>
	<div class="col-md-2">
		<button type="submit" class="btn btn-primary">Search</button>
		<a asp-action="Index" class="btn btn-secondary">Clear</a>
	</div>
</form>

<a asp-action="Create" asp-controller="Product" class="btn btn-secondary">
	Create Product
</a>

@if (TempData["Message"] != null)
{
	<div class="alert alert-success fade show" role="alert">
		@TempData["Message"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"
			aria-label="Close"></button>
	</div>
}

@if (Model.Count() == 0)
{
	<p>No products are currently found</p>
} 
else
{
<table class="table table-striped">
	<thead>
		<tr>
			<th>@Html.DisplayNameFor(m => m.First().Title)</th>
			<th>@Html.DisplayNameFor(m => m.First().Price)</th>
			<th>Links</th>
		</tr>
	</thead>
	<tbody>
		@foreach (Product product in Model)
		{
			<tr>
				<td>@Html.DisplayFor(p => product.Title)</td>
				<td>@Html.DisplayFor(p => product.Price)</td>
				<td>
					<a class="btn btn-primary" asp-controller="Product"
						asp-action="Edit"
						asp-route-id="@product.ProductId">Update</a>
				    <a class="btn btn-danger" asp-controller="Product"
						asp-action="Delete"
						asp-route-id="@product.ProductId">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>
}